@page "/products"
@using BlazorClient.Services
@using BlazorClient.Models
@inject ProductService ProductService
@inject IJSRuntime JsRuntime

<div class="products-container">
    <div class="page-header">
        <h2>Управление товарами</h2>
        <button class="btn-add" @onclick="ShowCreateForm">
            Добавить товар
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loader">Загрузка...</div>
    }
    else if (products.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">🛍️</div>
            <h3>Товаров пока нет</h3>
            <p>Нажмите "Добавить товар", чтобы начать</p>
        </div>
    }
    else
    {
        <div class="products-grid">
            @foreach (var product in products)
            {
                <div class="product-card">
                    <div class="card-header">
                        <span class="category-badge">@product.Category</span>
                                <div class="card-actions">
                                    <button class="action-btn edit-btn" @onclick="() => ShowEditForm(product)">Редактировать</button>
                                    <button class="action-btn delete-btn" @onclick="() => ConfirmDelete(product)">Удалить</button>
                                </div>
                    </div>
                    <h3 class="product-name">@product.Name</h3>
                    <p class="product-description">@product.Description</p>
                    <div class="product-footer">
                        <span class="product-price">@product.Price.ToString("F2") ₽</span>
                        <span class="product-id">ID: @product.Id</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showForm)
{
    <div class="modal">
        <div class="modal-card">
            <div class="modal-header">
                <h3>@(isEditMode ? "Редактировать товар" : "Новый товар")</h3>
                <button class="close-btn" @onclick="CloseForm">✖</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Название</label>
                    <input @bind="currentProduct.Name" placeholder="Введите название" />
                </div>
                <div class="form-group">
                    <label>Категория</label>
                    <input @bind="currentProduct.Category" placeholder="Например: Электроника" />
                </div>
                <div class="form-group">
                    <label>Цена</label>
                    <input type="number" step="0.01" @bind="currentProduct.Price" placeholder="0.00" />
                </div>
                <div class="form-group">
                    <label>Описание</label>
                    <textarea @bind="currentProduct.Description" rows="3" placeholder="Описание товара..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CloseForm">Отмена</button>
                <button class="btn-save" @onclick="SaveProduct">Сохранить</button>
            </div>
        </div>
    </div>
}

<style>
