    }
    
    .btn-save:hover {
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(40, 167, 69, 0.3);
    }
</style>

@code {
    private List<Product> products = new();
    private bool isLoading = true;
    private bool showForm = false;
    private bool isEditMode = false;
    private Product currentProduct = new();
    
    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }
    
    private async Task LoadProducts()
    {
        isLoading = true;
        products = await ProductService.GetProductsAsync();
        isLoading = false;
    }
    
    private void ShowCreateForm()
    {
        currentProduct = new Product();
        isEditMode = false;
        showForm = true;
    }
    
    private void ShowEditForm(Product product)
    {
        currentProduct = new Product
        {
            Id = product.Id,
            Name = product.Name,
            Price = product.Price,
            Category = product.Category,
            Description = product.Description
        };
        isEditMode = true;
        showForm = true;
    }
    
    private async Task SaveProduct()
    {
        try
        {
            // Проверка заполнения обязательных полей
            if (string.IsNullOrWhiteSpace(currentProduct.Name))
            {
                await JsRuntime.InvokeVoidAsync("alert", "Пожалуйста, введите название товара");
                return;
            }
            
            if (currentProduct.Price <= 0)
            {
                await JsRuntime.InvokeVoidAsync("alert", "Пожалуйста, введите корректную цену");
                return;
            }
            
            if (isEditMode)
            {
                await ProductService.UpdateProductAsync(currentProduct.Id, currentProduct);
                await JsRuntime.InvokeVoidAsync("alert", "✅ Товар успешно обновлён!");
            }
            else
            {
                await ProductService.CreateProductAsync(currentProduct);
                await JsRuntime.InvokeVoidAsync("alert", "✅ Товар успешно добавлен!");
            }
            
            CloseForm();
            await LoadProducts();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при сохранении: {ex.Message}");
            await JsRuntime.InvokeVoidAsync("alert", $"❌ Ошибка: {ex.Message}");
        }
    }
    
    private async Task ConfirmDelete(Product product)
    {
        bool confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"🗑️ Удалить товар '{product.Name}'?");
        if (confirmed)
        {
            try
            {
                await ProductService.DeleteProductAsync(product.Id);
                await LoadProducts();
                await JsRuntime.InvokeVoidAsync("alert", "✅ Товар удалён");
            }
            catch (Exception ex)
            {
                await JsRuntime.InvokeVoidAsync("alert", $"❌ Ошибка удаления: {ex.Message}");
            }
        }
    }
    
    private void CloseForm()
    {
        showForm = false;
        currentProduct = new Product();
    }
}