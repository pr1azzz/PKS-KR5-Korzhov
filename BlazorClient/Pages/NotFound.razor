@page "/404"
@inject NavigationManager Navigation

<h3>❌ Страница не найдена</h3>

<p>Извините, запрошенная страница не существует.</p>

<button class="btn btn-primary" @onclick="GoHome">Вернуться на главную</button>

@code {
    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
}